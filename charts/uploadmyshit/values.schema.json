{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Values Helm shares with every chart, and Rancher fills in (global.cattle.*). Accepted, not read.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkRooms": { "type": "boolean" },
        "ipv4Prefix": { "type": "integer", "minimum": 8, "maximum": 32 },
        "ipv6Prefix": { "type": "integer", "minimum": 16, "maximum": 128 },
        "maxRoomPeers": { "type": "integer", "minimum": 2 },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "maxConnectionsPerIp": { "type": "integer", "minimum": 1 },
        "clientIpHeader": { "type": "string" },
        "trustedProxies": { "type": "array", "items": { "type": "string" } },
        "shutdownDelaySeconds": { "type": "integer", "minimum": 0 },
        "logFormat": { "enum": ["text", "json"] },
        "logLevel": { "type": "string" },
        "extraArgs": { "type": "array", "items": { "type": "string" } },
        "extraEnv": { "type": "array" }
      }
    },
    "ice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stunUrls": { "type": "array", "items": { "type": "string" } },
        "turn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "urls": { "type": "array", "items": { "type": "string" } },
            "username": { "type": "string" },
            "credential": { "type": "string" },
            "secret": { "type": "string" },
            "ttlSeconds": { "type": "integer", "minimum": 600 },
            "existingSecret": { "type": "string" }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyId": { "type": "string" },
            "apiToken": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "secret": { "type": "string" },
        "existingSecret": { "type": "string" },
        "ttlSeconds": { "type": "integer", "minimum": 60 },
        "allowInsecure": { "type": "boolean" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "annotations": { "type": ["object", "null"] },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
