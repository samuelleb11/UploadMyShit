{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A placeholder: the real Worker is named at deploy time (npm run deploy -- --name <yours>),
  // so no account's Worker name or subdomain lands in this public repository.
  "name": "uploadmyshit-relay",
  "main": "relay.js",
  "compatibility_date": "2026-09-15",
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  // SQLite-backed: the kind every plan, the free one included, can create.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "observability": { "enabled": true }
}
